# ============================================================
# LabelPadho - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# 
# NEVER commit .env to git — it contains your secrets.
# .gitignore already excludes it.
# ============================================================

# Required: Your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Backend server config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional: Hosted Postgres for the shared product catalog (e.g. Neon free tier).
# Leave unset to use a local SQLite file (backend/labelpadho.db).
# Paste the connection string exactly as Neon gives it, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
