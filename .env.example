# ============================================================
# LabelPadho - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# 
# NEVER commit .env to git — it contains your secrets.
# .gitignore already excludes it.
# ============================================================

# Required: Your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Backend server config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional: Hosted Postgres for the shared product catalog (e.g. Neon free tier).
# Leave unset to use a local SQLite file (backend/labelpadho.db).
# Paste the connection string exactly as Neon gives it, e.g.:
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional: limits that protect your free Gemini quota (per client, per hour; 0 disables)
RATE_LIMIT_SCANS_PER_HOUR=15
RATE_LIMIT_TRANSLATIONS_PER_HOUR=30

# Optional: identify your app to Open Food Facts (barcode lookups)
# OFF_USER_AGENT=LabelPadho/1.0 (you@example.com)

# Optional: enables admin endpoints (reports queue, catalog seeding, deletes).
# Send as the X-Admin-Key header. Leave unset to disable them.
# ADMIN_KEY=
